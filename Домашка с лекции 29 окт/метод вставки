#include <iostream>
#include <clocale>
using namespace std;

int main()
{
    setlocale(LC_ALL, "Russian");
    const int n = 7;
    int arr[n];

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    for (int i = 1; i < n; i++) 
    {
        int temp = arr[i];
        int j = i - 1;
        bool f = false;

        while (j >= 0 && f == false) 
        {
            if (arr[j] > temp) 
            {
                arr[j + 1] = arr[j];
                j--;
            }
            else 
            {
                f = true; 
            }
        }
        
        arr[j + 1] = temp;
        }
        cout << "упорядоченный массив: ";
        for (int k = 0; k < n; k++) {
            cout << arr[k] << " ";
        }
        cout << endl;

    return 0;
}
