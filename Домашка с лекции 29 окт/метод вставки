#include <iostream>
#include <clocale>
#include <cstdlib>
using namespace std;

int main()
{
    int arr[7];
    setlocale(LC_ALL, "Russian");
    for (int t = 0; t < 7; t++)
    {
        cin >> arr[t];
    }
    for (int j = 1; j < 7; j ++)
    {
        for(int i = j; i > 0 && arr[i-1] > arr[i]; i--)
        swap(arr[i-1], arr[i]); 
    }
    cout << "отсортированный массив: ";
    for (int k = 0; k < 7; k++)
    {
        cout << arr[k] << " ";
    }
    cout << endl;
    return 0;
}
