#include <iostream>
#include <clocale>
#include <cstdlib>
using namespace std;

int main()
{
    int matrix[2][3];
    for (int i = 0; i < 2; i++)
    {
        for (int j = 0; j < 3; j++)
        {
            matrix[i][j] = rand() % 100;
            cout << matrix[i][j] << " ";
        }
    cout << endl;
    }
    cout << "Сумма элементов строк: " << '\n';
    for (int m = 0; m < 2; ++m)
    {
        int sum = 0;
        for (int n = 0; n < 3; ++n)
        {
            sum += matrix[m][n];
        }
        cout << sum << '\n';
    }
    return 0;
}
