#include <iostream>
#include <clocale>
using namespace std;

int main()
{
    setlocale(LC_ALL, "Russian");
    int arr[7];
    for (int i = 0; i < 7; i++)
    {
        cin >> arr[i];
    }
    for (int k = 0; k < 6; k++)
    {
        int minIndex = k;
        for (int j = k + 1; j < 7; j++)
        {
            if (arr[j] < arr[minIndex])
            {
                minIndex = j;
            }
        }
        if (minIndex != k)
        {
            int t = arr[k];
            arr[k] = arr[minIndex];
            arr[minIndex] = t;
        }
    }
    cout << "отсортированный массив: ";
    for (int r = 0; r < 7; r++)
    {
        cout << arr[r] << " ";
    }
    return 0;
}
