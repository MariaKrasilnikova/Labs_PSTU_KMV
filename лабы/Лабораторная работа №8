#include <iostream>
#include <clocale>
#include <cstdio>
#include <cstring>
using namespace std;

struct Mdisk {
    char name[50];
    char author[50];
    int  duration;
    int  price;
};

const char* FILENAME = "laba8.dat";

void createFile() {
    FILE* fp = fopen(FILENAME, "wb");
    if (!fp) { cout << "Ошибка в открытии файла!\n"; return; }

    Mdisk disks[4] = {
        {"RandomAccessMemories", "Daft Punk", 74, 1300},
        {"OKComputer",           "Radiohead", 53, 1900},
        {"BackinBlack",          "AC/DC",     42, 990},
        {"TheDarkSideoftheMoon", "PinkFloyd", 43, 1450}
    };

    fwrite(disks, sizeof(Mdisk), 4, fp);
    fclose(fp);
    cout << "Файл успешно сформирован!\n";
}

void printFile() {
    FILE* fp = fopen(FILENAME, "rb");
    if (!fp) { cout << "Ошибка в открытии файла\n"; return; }

    Mdisk d;
    cout << "\nСодержимое файла:\n";
    while (fread(&d, sizeof(Mdisk), 1, fp) == 1) {
        cout << d.name << " | " << d.author
             << " | " << d.duration << " мин | " << d.price << " руб\n";
    }
    fclose(fp);
    cout << '\n';
}

int getCount() {
    FILE* fp = fopen(FILENAME, "rb");
    if (!fp) return 0;
    fseek(fp, 0, SEEK_END);
    long size = ftell(fp);
    fclose(fp);
    return static_cast<int>(size / sizeof(Mdisk));
}

void DeletebyDuration(int targetduration) {
    int count = getCount();
    if (count == 0) return;

    Mdisk* arr = new Mdisk[count];
    FILE* fp = fopen(FILENAME, "rb");
    fread(arr, sizeof(Mdisk), count, fp);
    fclose(fp);

    int t = -1;
    for (int i = 0; i < count; i++) {
        if (arr[i].duration == targetduration) {
            t = i;
            break;                       // нашли — выходим из цикла, а не из функции
        }
    }

    if (t == -1) {
        cout << "Элемент с этой продолжительностью не найден\n";
        delete[] arr;
        return;
    }

    char removed[50];
    strcpy(removed, arr[t].name);        // сохранили имя ДО сдвига

    for (int i = t; i < count - 1; i++)
        arr[i] = arr[i + 1];

    fp = fopen(FILENAME, "wb");          // <-- "wb", не "rb"!
    fwrite(arr, sizeof(Mdisk), count - 1, fp);
    fclose(fp);

    cout << "Элемент \"" << removed << "\" успешно удален!\n";
    delete[] arr;
}

void addAfterIndex(int targetIndex) {
    int count = getCount();
    if (targetIndex < 0 || targetIndex >= count) {
        cout << "Неверно введен номер!\n";
        return;
    }

    Mdisk* arr = new Mdisk[count];
    FILE* fp = fopen(FILENAME, "rb");
    fread(arr, sizeof(Mdisk), count, fp);
    fclose(fp);

    Mdisk newDisks[2] = {
        {"NewAlbum1", "NewAuthor1", 60, 1500},
        {"NewAlbum2", "NewAuthor2", 55, 1200}
    };

    fp = fopen(FILENAME, "wb");
    fwrite(arr, sizeof(Mdisk), targetIndex + 1, fp);
    fwrite(newDisks, sizeof(Mdisk), 2, fp);
    fwrite(arr + targetIndex + 1, sizeof(Mdisk), count - targetIndex - 1, fp);
    fclose(fp);

    cout << "Добавлены два элемента после элемента под номером "
         << targetIndex << '\n';
    delete[] arr;
}

int main() {
    setlocale(LC_ALL, "Russian");
    createFile();
    printFile();

    int dur;
    cout << "Введите продолжительность диска для удаления: ";
    cin >> dur;
    DeletebyDuration(dur);
    printFile();

    int ind;
    cout << "Введите номер диска, после которого добавить 2: ";
    cin >> ind;
    addAfterIndex(ind);
    printFile();

    return 0;
}
