#include <iostream>
using namespace std;

float del(float a, float b)
{
    float n = a / b;
    return n;
}

double del(double a, double b)
{
    double n = a / b;
    return n;
}


int main()
{
    float x = 2.5;
    float y = 5.0;
    double x1 = 6.42;
    double y1 = 3.54;
    double x2 = 4.0, y2 = 5.0;
    double x3 = 6.0, y3 = 9.0;
    cout << del(x, y) << '\n' << del(x1, y1) << '\n' << del(x2/x3, y2/y3);
    return 0;
}
