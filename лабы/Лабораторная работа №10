#include <iostream>
#include <clocale>
using namespace std;

int main()
{
    setlocale(LC_ALL, ".UTF8");
    int n, m;
    cout << "Введите кол-во строк и столбцов матрицы: ";
    cin >> n >> m;
    int** arr = new (nothrow) int*[n];
    for (int i = 0; i < n; i++)
    {
        arr[i] = new int [m];
    }
    cout << '\n' << "Введите матрицу: ";
    for(int i = 0; i < n; i++)
    {
        for( int j = 0; j < m; j++)
        {
            cin >> arr[i][j];
        }
        cout << endl;
    }
    cout << '\n' << "Введите число, строки с которым удалятся: ";
    int x;
    cin >> x;
    bool f = false;
    for (int i = 0; i < n; i++)
    {
        for(int j = 0; j < m; j++)
        {
            if (arr[i][j] == x)
            {
                f = true;
            }
        }
        if (f)
        {
            for(int k = i; k < n - 1; k++)
            {
                for(int j = 0; j < m; j++)
                {
                    arr[k][j] = arr[k+1][j];
                }
            }
            n--;
            i--;
        }
    }
    if (f == false)
    cout << "Числа " << x << " нет в матрице" << '\n';
    for (int i = 0; i < n; i++)
    {
        for(int j = 0; j < m; j++)
        {
            cout << arr[i][j] << ' ';
        }
        cout << endl;
    }
    for (int i = 0; i < n; i++)
    {
        delete[] arr[i];
    }
    delete[] arr;
    arr = nullptr;
    return 0;
    }
